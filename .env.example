# Required. 32+ chars. Generate with: npm run gen-secret
AUTH_SECRET=

# Public origin. Must match the Google redirect URI you registered.
APP_URL=http://localhost:3000

# --- optional: real delivery. Unset = codes print to the server console. ---
# Email (resend.com, 3k/month free)
RESEND_API_KEY=
MAIL_FROM="SitePulse <onboarding@resend.dev>"

# SMS — pick one. There is no permanently-free SMS API; both have free credits.
FAST2SMS_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# --- optional: Google sign-in ---
# console.cloud.google.com → Credentials → OAuth client ID → Web application
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to true to make phone OTP mandatory (demo day)
REQUIRE_PHONE_VERIFICATION=false
